# ============================================================
# Profesor TCG - Variables de entorno requeridas
# Copia este archivo como `.env.local` y completa los valores.
# NUNCA subas `.env.local` (ya está en .gitignore).
# ============================================================

# ---------- Supabase (Project Settings > API) ----------
# URL pública del proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública (anon/publishable). Se expone al cliente: es segura.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave de servicio (service_role). SOLO se usa del lado del servidor
# (admin endpoints, reversión de reservas, cachés). NO exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- URLs de la app ----------
# URL pública de la app (para deep links compartidos y OG tags).
# En local: http://localhost:3000 · En producción: https://tcgclaim.online
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Discord ----------
# Webhook para notificar nuevas publicaciones del marketplace en un canal.
# Se crea en Discord: Configuración del servidor > Integraciones > Webhooks.
DISCORD_WEBHOOK_URL=

# ---------- OAuth: Login con Google ----------
# No requiere variables de entorno en la app: se configura en el dashboard
# de Supabase (Authentication > Providers > Google) con las credenciales de
# Google Cloud Console.
# - Redirect URL del proveedor: <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback
# - Redirect URL de la app (callback local): http://localhost:3000/auth/callback
# - Redirect URL de la app (producción): https://<dominio>/auth/callback
# El email del usuario de Google se usa para crear el perfil automáticamente
# (trigger on_auth_user_created). Asegurate de que el email de la cuenta
# Google esté verificado en Google Cloud Console para que se acepte el login.

# ---------- Integraciones externas (opcional) ----------
# PokéTrace - precios TCGPlayer + eBay + CardMarket (250 req/día free)
# Si se define acá, tiene prioridad sobre la clave guardada en el panel admin.
POKETRACE_API_KEY=
# TCG API - precios de 89+ juegos (100 req/día free)
# TCGAPI_KEY=
# PokeWallet - precios TCGPlayer + CardMarket (100 req/hora free)
# POKEWALLET_API_KEY=
